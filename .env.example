# LLM provider configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI (optional; used when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Persistence
DATABASE_URL=sqlite:///./triage.db

# Triage guardrails
MIN_HYPOTHESIS_CONFIDENCE=0.0

# Weight of LLM self-confidence vs signature severity when blending (0.0-1.0)
CONFIDENCE_LLM_WEIGHT=0.6
